<Modal @modalIsOpened={{@modalIsOpened}} @options={{@options}} @onClose={{@onDecline}} @position="center"
    style="--flb-modal-width: 680px;" as |modal|>
    <modal.header @onClose={{@onDecline}} class="bg-gray-50 dark:bg-gray-900" as |header|>
        <div class="flex flex-col">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">{{this.title}}</h3>
            {{#if this.subTitle}}
            <p class="text-sm text-gray-500 dark:text-gray-400">
                {{this.subTitle}}
            </p>
            {{/if}}

        </div>
        <header.close class="dark:text-white  text-2xl focus:outline-none" />
    </modal.header>

    <modal.body>

        <div class="modal-body-container p-0">
            {{#if (eq this.currentStep 1)}}
            {{!-- Step 1: Upload --}}
            <div class="flex flex-col items-center  h-96 justify-center  bg-white dark:bg-gray-800">
                <div class="text-center">
                    <div class="mb-4">
                        <FaIcon @icon="file" @size="4x" class="text-gray-400" />
                    </div>

                    {{#let (file-queue name="bulk-import" onFileAdded=this.handleUpload) as |queue|}}
                    <label for="bulk-import-upload"
                        class="btn btn-primary px-6 py-2 rounded-md cursor-pointer bg-blue-500 text-white font-medium hover:bg-blue-600">
                        Choose file
                    </label>
                    <input type="file" id="bulk-import-upload" class="hidden" {{queue.selectFile}}
                        accept=".csv,.xlsx,.xls" />
                    {{/let}}

                    <p class="mt-4 text-gray-500">Only <strong>JSON</strong>, <strong>CSV</strong> or
                        <strong>Excel</strong> files may be imported
                    </p>
                </div>
            </div>

            {{else if (eq this.currentStep 2)}}
            {{!-- Step 2: Mapping --}}
            <div class="p-4 overflow-y-auto h-96 bg-white dark:bg-gray-800">
                <div class="space-y-4">
                    {{#each this.mappings as |group|}}
                    <div>
                        <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2 border-b pb-1">
                            {{group.group}}</h4>
                        <div class="space-y-2">
                            {{#each group.fields as |map|}}
                            <div class="flex items-center justify-between">
                                <label
                                    class="w-1/3 text-xs font-medium text-gray-700 dark:text-gray-300 text-right pr-3">{{map.label}}</label>
                                <div class="w-2/3 relative">
                                    <select
                                        class="form-select w-full text-sm py-1 rounded-md border-gray-300 dark:bg-gray-700 dark:border-gray-600 {{if map.selectedColumn 'text-gray-900 dark:text-white' 'text-gray-400 dark:text-gray-500'}}"
                                        {{on "change" (fn this.updateMapping map)}}>
                                        <option value="">choose field</option>
                                        {{#each this.csvHeaders as |header|}}
                                        <option value={{header}} selected={{eq map.selectedColumn header}}
                                            class="text-gray-900 dark:text-white">{{header}}
                                        </option>
                                        {{/each}}
                                    </select>
                                    {{#if (and map.required (not map.selectedColumn))}}
                                    <div class="absolute inset-y-0 right-8 flex items-center">
                                        <FaIcon @icon="exclamation-circle" class="text-red-500" />
                                        <Attach::Tooltip @class="clean" @animation="scale" @placement="top">
                                            <div
                                                class="bg-white dark:bg-gray-300 px-2 py-1 text-xs rounded-sm text-red-500 font-semibold">
                                                Required
                                            </div>
                                        </Attach::Tooltip>
                                    </div>
                                    {{/if}}
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            {{else if (eq this.currentStep 3)}}
            {{!-- Step 3: Review --}}
            <div class="p-6 overflow-y-auto h-96 bg-white dark:bg-gray-800">
                <div class="border border-red-200 h-full rounded-md p-4">
                    <h4 class="text-red-500 font-bold mb-4">{{this.dryRunResults.length}} tasks will not be imported
                    </h4>
                    <div class="space-y-3">
                        {{#each this.dryRunResults as |error|}}
                        <div>
                            <p class="font-semibold text-gray-800 dark:text-gray-200 text-sm">Row {{error.row}}, Column
                                <i>{{error.column}}</i>
                            </p>
                            <p class="text-gray-500 text-xs">{{error.message}}</p>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>

            {{else if (eq this.currentStep 4)}}
            {{!-- Step 4: Success --}}
            <div class="flex flex-col items-center justify-center h-96 bg-white dark:bg-gray-800">
                <div class="mb-6">
                    <div class="w-24 h-24 rounded-full border-4 border-green-500 flex items-center justify-center">
                        <FaIcon @icon="check" class="text-green-500 text-5xl" />
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Import Complete</h3>
                {{#if (eq this.importResult.success 0)}}
                <p class="text-gray-500 font-medium mb-6">No orders imported</p>
                {{else}}
                <p class="text-gray-500 font-medium mb-6">{{this.importResult.success}} {{if (eq
                    this.importResult.success 1) "order" "orders"}} imported successfully</p>
                {{/if}}

                <button class="btn btn-default" type="button" {{on "click" this.scheduleImport}}>
                    Schedule import to repeat
                </button>
            </div>
            {{else if (eq this.currentStep 5)}}
            {{!-- Step 5: Schedule Import --}}
            <div class="p-4 overflow-y-auto h-96 bg-white dark:bg-gray-800">
                <OrderImport::ScheduleSettings @name={{this.scheduleSettings.name}}
                    @onNameChange={{this.updateScheduleName}} @isEditing={{this.isEditingSchedule}} />
            </div>
            {{else if (eq this.currentStep 6)}}
            {{!-- Step 6: Scheduled Imports --}}
            <div class="p-4 overflow-y-auto h-96 bg-white dark:bg-gray-800">
                <OrderImport::ScheduledList @selectedImport={{this.selectedImport}} @onSelect={{this.selectImport}}
                    @itemToDelete={{this.itemToDelete}} />
            </div>
            {{/if}}
        </div>
    </modal.body>

    <modal.footer class="bg-gray-50 dark:bg-gray-900">
        <div class="w-full flex justify-between items-center">
            {{#if (eq this.currentStep 1)}}
            <div class="flex space-x-2">
                <button class="btn btn-default" type="button" {{on "click" @onDecline}}>
                    Cancel
                </button>
                <button class="btn btn-default" type="button" {{on "click" this.viewScheduledImports}}>
                    View scheduled imports
                </button>
            </div>
            {{else if (eq this.currentStep 4)}}
            <button class="btn btn-default" type="button" {{on "click" this.reset}}>
                New import
            </button>
            <button class="btn btn-primary bg-blue-500 text-white hover:bg-blue-600" type="button" {{on "click"
                @onConfirm}}>
                Done
            </button>
            {{else if (eq this.currentStep 6)}}
            <button class="btn btn-default" type="button" {{on "click" this.reset}}>
                Close
            </button>
            <div class="flex gap-2">
                <button class="btn btn-default" type="button" {{on "click" this.deleteSelectedImport}} disabled={{not
                    this.selectedImport}}>
                    Delete
                </button>
                <button class="btn btn-default" type="button" {{on "click" this.editSelectedImport}} disabled={{not
                    this.selectedImport}}>
                    Edit...
                </button>
            </div>
            {{else}}
            <button class="btn btn-default" type="button" {{on "click" (if (or (eq this.currentStep 1) (eq
                this.currentStep 3)) @onDecline this.prevStep)}}>
                {{#if (eq this.currentStep 3)}}Cancel Import{{else if (eq this.currentStep 5)}}Back{{else}}Back{{/if}}
            </button>

            <button class="btn btn-primary bg-blue-500 text-white hover:bg-blue-600" type="button" {{on "click"
                this.nextStep}}>
                {{#if this.isProcessing}}
                <FaIcon @icon="spinner" @spin={{true}} class="mr-2" />
                {{/if}}
                {{this.nextButtonText}}
            </button>
            {{/if}}
        </div>
    </modal.footer>
</Modal>