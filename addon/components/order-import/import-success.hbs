<div class="bg-white rounded-lg shadow-2xl w-full max-w-2xl mx-auto">
    <div class="flex items-center justify-between p-6 border-b border-gray-200">
        <div>
            <h2 class="text-xl font-semibold text-gray-900">Import Complete</h2>
            <p class="text-sm text-gray-600 mt-1">2 tasks imported successfully</p>
        </div>
        <button type="button" class="close text-2xl focus:outline-none" aria-label="Close" {{on "click" @onDone}}>
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="p-12 flex flex-col items-center justify-center space-y-6">
        <div class="w-24 h-24 rounded-full bg-green-100 flex items-center justify-center">
            <FaIcon @icon="check" @size="3x" class="text-green-600" />
        </div>

        <div class="text-center">
            <h3 class="text-2xl font-semibold text-gray-900 mb-2">Import Complete</h3>
            <p class="text-gray-600">2 tasks were imported</p>
            <p class="text-gray-500 text-sm mt-1">2 tasks not assigned</p>
        </div>

        <div class="flex items-center gap-3 pt-4">
            <button type="button"
                class="px-5 py-2.5 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 font-medium"
                {{on "click" @onSchedule}}>
                Schedule import to repeat
            </button>
            <button type="button"
                class="px-5 py-2.5 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 font-medium"
                {{on "click" @onNew}}>
                New import
            </button>
        </div>
    </div>

    <div class="flex items-center justify-end px-6 py-4 border-t border-gray-200 bg-gray-50">
        <button type="button" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium"
            {{on "click" @onDone}}>
            Done
        </button>
    </div>
</div>