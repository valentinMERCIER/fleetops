<div class="bg-white rounded-lg shadow-2xl w-full max-w-3xl mx-auto">
    <div class="flex items-center justify-between p-6 border-b border-gray-200">
        <div>
            <h2 class="text-xl font-semibold text-gray-900">Create Order Template</h2>
            <p class="text-sm text-gray-600 mt-1">Match the columns in your file to the corresponding order attributes
            </p>
        </div>
        <button type="button" class="close text-2xl focus:outline-none" aria-label="Close" {{on "click" @onBack}}>
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="p-6 max-h-96 overflow-y-auto">
        {{!-- Recipient Section --}}
        <div class="mb-6">
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Recipient</h3>
            <div class="space-y-3">
                <div class="flex items-center gap-4">
                    <label class="w-40 text-right text-sm font-medium text-gray-700">Name</label>
                    <div class="flex-1 relative">
                        <select
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900">
                            <option>Recipient_Name</option>
                        </select>
                    </div>
                </div>
                {{!-- Add more fields as needed --}}
            </div>
        </div>

        {{!-- Destination Section --}}
        <div>
            <h3 class="text-sm font-semibold text-gray-700 mb-4">Destination</h3>
            <div class="space-y-3">
                <div class="flex items-center gap-4">
                    <label class="w-40 text-right text-sm font-medium text-gray-700">Address Line 1</label>
                    <div class="flex-1 relative">
                        <select
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900">
                            <option>Address_Line1</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-200 bg-gray-50">
        <button type="button"
            class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-100 font-medium" {{on "click"
            @onBack}}>
            Back
        </button>
        <button type="button" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium"
            {{on "click" @onImport}}>
            Import
        </button>
    </div>
</div>