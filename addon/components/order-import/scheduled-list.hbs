<div class="border border-gray-300 dark:border-gray-600 rounded-md overflow-auto overflow-y-auto max-h-full h-full pb-4 px-2 relative"
    {{did-update this.handleDeleteTrigger @itemToDelete}}> {{!-- Scheduled
    Section --}}
    <div>
        <button type="button"
            class="w-full flex items-center gap-2 text-left border-gray-300 dark:border-gray-600 sticky top-0 bg-white dark:bg-gray-800 pt-4 ">
            <FaIcon @icon="chevron-down" class="text-gray-400 text-xs" />
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Scheduled</span>
        </button>
        <div class="divide-y divide-gray-200 dark:divide-gray-700">
            {{#each this.scheduledImports as |importItem|}}
            <button type="button"
                class="w-full pl-6 pr-2 py-1 text-left transition-colors {{if (eq @selectedImport importItem) 'bg-blue-100 dark:bg-blue-900' 'hover:bg-gray-50 dark:hover:bg-gray-800'}}"
                {{on "click" (fn @onSelect importItem)}}>
                <div class="text-sm font-medium text-gray-900 dark:text-gray-100">{{importItem.name}}</div>
                <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                    {{importItem.schedule}}
                </div>
            </button>
            {{else}}
            <div class="px-4 py-3 text-xs text-center text-gray-400 dark:text-gray-500">
                No scheduled imports
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- Completed Section --}}
    <div class="border-gray-300 dark:border-gray-600 pb-6">
        <button type="button"
            class="w-full flex items-center gap-2 text-left bg-gray-100 dark:bg-gray-800  border-gray-300 dark:border-gray-600 sticky top-0 bg-white dark:bg-gray-800  pt-4 ">
            <FaIcon @icon="chevron-down" class="text-gray-400 text-xs" />
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Completed</span>
        </button>
        <div class="divide-y divide-gray-200 dark:divide-gray-700">
            {{#each this.completedImports as |importItem|}}
            <button type="button"
                class="w-full pl-6 pr-2 py-1 text-left transition-colors {{if (eq @selectedImport importItem) 'bg-blue-100 dark:bg-blue-900' 'hover:bg-gray-50 dark:hover:bg-gray-800'}}"
                {{on "click" (fn @onSelect importItem)}}>
                <div class="text-sm font-medium text-gray-900 dark:text-gray-100">{{importItem.name}}</div>
                <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                    {{importItem.schedule}}
                </div>
            </button>
            {{else}}
            <div class="px-4 py-3 text-xs text-center text-gray-400 dark:text-gray-500">
                No completed imports
            </div>
            {{/each}}
        </div>
    </div>
</div>