<div class="bg-white rounded-lg shadow-2xl w-full max-w-2xl mx-auto">
    <div class="flex items-center justify-between p-6 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900">Import Orders</h2>
        <button type="button" class="close text-2xl focus:outline-none" aria-label="Close" {{on "click" @onCancel}}>
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="p-12">
        <div class="flex flex-col items-center justify-center space-y-6">
            <div class="w-24 h-24 flex items-center justify-center">
                <FaIcon @icon="cloud-upload-alt" @size="5x" class="text-gray-400" />
            </div>

            {{#let (file-queue name="orders" onFileAdded=@onUpload) as |queue|}}
            <label for="orders-file-upload"
                class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition-colors cursor-pointer">
                {{#if @isUploading}}
                Uploading...
                {{else}}
                Choose file
                {{/if}}
            </label>
            <input type="file" id="orders-file-upload" class="hidden"
                accept="text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/json"
                {{queue.selectFile}} />
            {{/let}}

            <p class="text-sm text-gray-600">
                Only <span class="font-medium">JSON, CSV</span> or <span class="font-medium">Excel</span> files may be
                imported
            </p>

            <a href="#" class="text-sm text-blue-600 hover:text-blue-700 hover:underline">
                Learn more & download a CSV template
            </a>
        </div>
    </div>

    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-200 bg-gray-50">
        <button type="button"
            class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-100 font-medium" {{on "click"
            @onCancel}}>
            Cancel
        </button>
        <button type="button" class="text-blue-600 hover:text-blue-700 font-medium" {{on "click" @onViewScheduled}}>
            View scheduled imports
        </button>
    </div>
</div>